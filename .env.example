# 可选：页面文本少于该字符数时标记为待整理
EKB_MINIMUM_TEXT_LENGTH=20

# 可选：PDF 页面渲染分辨率（默认 150 DPI）
EKB_PDF_RENDER_DPI=150

# 可选：把数据库、原始资料、页面图像和本地读取结果统一保存到其他绝对路径。
# 建议通过“系统维护 → 存储位置”修改；修改后需重启服务。
# EKB_STORAGE_DIR=D:\\EKB-Data

# 可选：仅修改 8511 隔离测试实例的数据目录；不会影响 8501 正式资料。
# EKB_STAGING_STORAGE_DIR=D:\\EKB-Staging-Data

# 可选高级项：分别调整资料子目录、数据库、日志或运行状态位置。
# 资料子目录和数据库必须保持在对应的数据目录内。
# EKB_STORAGE_RAW_DIR=D:\\EKB-Data\\raw
# EKB_STORAGE_PAGES_DIR=D:\\EKB-Data\\pages
# EKB_STORAGE_MARKDOWN_DIR=D:\\EKB-Data\\markdown
# EKB_STORAGE_DATABASE_PATH=D:\\EKB-Data\\database\\knowledge.db
# EKB_STORAGE_LOGS_DIR=D:\\EKB-Logs
# EKB_STORAGE_RUNTIME_DIR=D:\\EKB-Runtime
# 测试服对应项使用 EKB_STAGING_RAW_DIR、EKB_STAGING_PAGES_DIR、
# EKB_STAGING_MARKDOWN_DIR、EKB_STAGING_DATABASE_PATH、EKB_STAGING_LOGS_DIR、
# EKB_STAGING_RUNTIME_DIR；建议由界面自动写入，不要手工编辑。

# 正式服务端点固定为 127.0.0.1:8501，不支持通过环境变量改写。

# ---------------------------------------------------------------------------
# AI（v0.8.7，可选，默认关闭）
#
# 默认为手动模式（manual）：不读取、也不需要 API Key，Nectivon 全部原有离线功能
# 在无 API Key 时完整可用，且不会发生任何真实 AI API 请求。
# v0.8.7 支持 Qwen、DeepSeek、Kimi、Hunyuan、GLM。推荐在 Web 界面
# “系统设置 → AI / 模型服务”中配置；非敏感设置写入 ai-providers-v1.json，
# API Key 保存到 Windows 凭据管理器或 DPAPI 加密文件，不写入 JSON。
#
# 下列环境变量只用于旧版 Qwen 兼容。启用该兼容入口时，将下行改为 api：
# EKB_AI_MODE=api
#
# 不要把真实 Key 写入本示例文件或提交到 Git。
# .env 已被 .gitignore 排除，必须在每台电脑上由用户重新配置。
# EKB_AI_API_KEY=<your-api-key>
#
# 可选模型配置（默认值即当前已核实型号，一般无需修改）：
# EKB_AI_LLM_MODEL=qwen3.7-plus
# EKB_AI_LLM_MODEL_HARD=qwen3.8-max
# EKB_AI_EMBEDDING_MODEL=qwen3.7-text-embedding
# EKB_AI_RERANK_MODEL=qwen3-rerank
# EKB_AI_TIMEOUT_SECONDS=30
