{
  "eval_id": "EKB-H11-VERSION-COLLISION-v1",
  "corpus_ref": "dirty-long-term-v1",
  "frozen_at": "2026-09-06T06:45:00+08:00",
  "model_expectation": "qwen3.8-max",
  "notes": "口语版本对撞集，仅在 dirty-long-term-v1 语料（含 v1.0/v1.1/v2.0草案 三代）上运行。§10：草案是语义——'最新正式版'草案不能自动赢；'最新看到的版本'应说明草案存在且状态不同。H09/H10 冻结集已覆盖点名/最新正式语义，本集聚焦口语冲突组合。",
  "cases": [
    {
      "case_id": "K01",
      "family": "h11_collision_values",
      "question": "M8 到底是 25 还是 28？",
      "expect": {
        "answer_fragments": ["25", "28"],
        "conflict_required": true
      },
      "metrics": {"version_discrimination": "answer"}
    },
    {
      "case_id": "K02",
      "family": "h11_collision_newest_colloquial",
      "question": "新版那个手册里 M8 是多少？",
      "expect": {
        "blur_lenient": {
          "positives": [["草案", "30", "35"], ["28"]],
          "uncertainty": ["草案", "正式", "确认"]
        }
      },
      "metrics": {"version_discrimination": "answer"}
    },
    {
      "case_id": "K03",
      "family": "h11_collision_stale",
      "question": "旧手册是不是过时了？",
      "expect": {
        "answer_any_fragments": [["过时", "取代", "更新", "修订", "新版", "1.1", "2.0"]]
