# Python
__pycache__/
*.py[cod]
*.pyd
.venv/
venv/

# Test and lint caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environment
.env
.env.*
!.env.example

# Local knowledge-base data (keep directory placeholders)
data/raw/*
!data/raw/.gitkeep
data/pages/*
!data/pages/.gitkeep
data/markdown/*
!data/markdown/.gitkeep
data/agent-readings/*
!data/agent-readings/.gitkeep
data/database/*
!data/database/.gitkeep
# Profile/preferences are runtime data outside the document subdirectories.
data/*.db
data/*.db-*
data/*.sqlite*
data/*preferences*.json
backups/*
!backups/.gitkeep
logs/*
!logs/.gitkeep
runtime/*
!runtime/.gitkeep

# Streamlit and editor artifacts
.streamlit/secrets.toml
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# AI staging instance (Phase 10A, fully isolated local test data)
staging-data/

# Local scratch space (audit scripts, ad-hoc conversion output); never committed
tmp/
.tmp-docx-agreement/
tests/_tmp_*/

# Zero-Batch real-user pilot data (REAL_USER layer; templates in
# templates/zero_batch/ are tracked, real records never enter Git)
artifacts/real_user_zero_batch/
.workbuddy/memory/

# Windows packaging outputs and caches (never commit generated installers)
packaging/windows/build/
packaging/windows/cache/
packaging/windows/dist/
packaging/windows/wix/Files.generated.wxs

# macOS packaging outputs and local signing material
packaging/macos/build/
packaging/macos/dist/
packaging/macos/*.icns

# v0.8.6 parallel staging test instances (8512+)
staging-data-*/

# Newly generated local audit evidence and old demonstration captures.
# These rules do not untrack files already present in Git history/index.
/artifacts/
/docs/archive/
/docs/v0.8-eval-results/
/docs/assets/showcase-v0.3.0/
/docs/assets/v0.5.0/
/Nectivon_v0.8.6_Internal_Archive/
/release-audit-output/

